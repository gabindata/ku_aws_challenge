# Claude API 키 — 반드시 서버에만 둔다. 클라이언트에서 직접 호출하지 않는다.
# https://console.anthropic.com → Settings → API keys 에서 발급받아 .env에 붙여넣는다.
# .env는 .gitignore에 있으니 절대 커밋되지 않는다.
ANTHROPIC_API_KEY=

# stub이면 가짜 LLM(stubLlm.ts)이 답한다. 키 없이도 서버 전체가 돌아간다.
# 키를 넣은 뒤 live로 바꾸면 그때부터 실제 Claude를 부른다. 코드는 고칠 게 없다.
# live인데 키가 비어 있으면 경고를 찍고 stub으로 되돌린다.
LLM_MODE=stub

# 모델은 아직 미정 — 실제로 붙여보고 정한다.
# 판정용과 리포트용을 따로 정할 수 있다. 둘 다 언제든 바꿀 수 있다고 보고 짰다.
#   ANTHROPIC_MODEL_JUDGE   매 턴 불린다. 응답 속도가 중요하다
#   ANTHROPIC_MODEL_REPORT  세션당 1~2번. 글솜씨가 중요하다
#   ANTHROPIC_MODEL         위 둘 중 안 적은 쪽의 기본값
# 셋 다 비워 두면 claude-opus-5를 쓴다.
#   claude-opus-5     품질 최상, 가장 비싸고 느림
#   claude-sonnet-5   품질·속도·비용 균형
#   claude-haiku-4-5  가장 빠르고 쌈, 페르소나 연기력은 떨어질 수 있음
# 설계 문서 7장: STT→LLM→TTS 왕복이 1초를 넘으면 어색해진다.
ANTHROPIC_MODEL_JUDGE=
ANTHROPIC_MODEL_REPORT=
ANTHROPIC_MODEL=

PORT=3000
# 프론트 개발 서버 origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
