# Claude API 키 — 반드시 서버에만 둔다. 클라이언트에서 직접 호출하지 않는다.
ANTHROPIC_API_KEY=
# 모델은 아직 미정 — 2주차에 실제로 붙여보고 정한다. 바꾸는 건 이 한 줄뿐.
#   claude-opus-5     품질 최상, 가장 비싸고 느림
#   claude-sonnet-5   품질·속도·비용 균형
#   claude-haiku-4-5  가장 빠르고 쌈, 페르소나 연기력은 떨어질 수 있음
# 설계 문서 7장: STT→LLM→TTS 왕복이 1초를 넘으면 어색해진다.
ANTHROPIC_MODEL=claude-opus-5
PORT=3000
# 프론트 개발 서버 origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
