# ─────────────────────────────────────────────────────────────
# 대회 게이트웨이 (AI Innovators Challenge)
# LiteLLM 프록시가 AWS Bedrock 앞에 서 있고, 말하는 규약은 OpenAI 쪽이다.
# 부르는 모델 자체는 Claude가 맞다.
# ─────────────────────────────────────────────────────────────

# 결과 CSV의 key 칸에 있는 sk- 로 시작하는 값.
# 이 파일(.env.example)이 아니라 .env에 적는다. .env는 .gitignore에 있어 커밋되지 않는다.
# 대회 가이드가 쓰는 API_KEY 이름으로 넣어도 읽는다.
LLM_API_KEY=

# stub이면 가짜 LLM(stubLlm.ts)이 답한다. 키 없이도 서버 전체가 돌아간다.
# 키를 넣은 뒤 live로 바꾸면 그때부터 실제 모델을 부른다. 코드는 고칠 게 없다.
# live인데 키가 비어 있으면 경고를 찍고 stub으로 되돌린다.
LLM_MODE=stub

# 게이트웨이 주소. 도메인 없이 EIP를 그대로 쓴다.
# 인증서는 이 IP 앞으로 정식 발급돼 있어 따로 손댈 게 없다.
LLM_BASE_URL=https://52.79.201.46/v1

# ─────────────────────────────────────────────────────────────
# 모델 — 실제 모델 ID가 아니라 게이트웨이 별칭으로 부른다.
# 판정용과 리포트용을 따로 정할 수 있고, 둘 다 언제든 바꿀 수 있다.
#   LLM_MODEL_JUDGE   매 턴 불린다. 응답 속도가 중요하다
#   LLM_MODEL_REPORT  세션당 1~2번. 글솜씨가 중요하다
#   LLM_MODEL         위 둘 중 안 적은 쪽의 기본값
# 셋 다 비워 두면 bedrock-gpt-5.6-terra 를 쓴다.
#
# 가이드에 적힌 별칭이 다 불리는 게 아니라 신청서에서 승인받은 것만 불린다.
# 지금 키로 부를 수 있는 것 (2026-09-19 확인):
#   bedrock-gpt-5.6-terra   판정 4.5천 토큰에 약 5초. 지금 쓸 수 있는 유일한 모델
#   bedrock-gpt-5.6-sol     20초를 줘도 응답이 안 온다. 판정에는 못 쓴다
# Claude 계열은 하나도 승인돼 있지 않다.
#
# 내 키로 실제 부를 수 있는 목록 확인:
#   curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $LLM_API_KEY"
#
# 설계 문서 7장: STT→LLM→TTS 왕복이 1초를 넘으면 어색해진다.
LLM_MODEL_JUDGE=
LLM_MODEL_REPORT=
LLM_MODEL=

PORT=3000

# 배포된 게임 화면의 주소. 이 주소에서 오는 요청만 받는다.
# 비워 두면 모든 주소를 허용한다 (개발 중에는 그대로 둬도 된다).
# 게임과 서버가 다른 도메인에 놓이므로 배포할 때는 반드시 채운다.
#   예: CLIENT_ORIGIN=https://malkori.pages.dev
# 쉼표로 여러 개를 적을 수 있다.
CLIENT_ORIGIN=

# ─────────────────────────────────────────────────────────────
# 음성 합성 (일레븐랩스)
# 키는 서버에만 둔다. 브라우저는 우리 서버의 /api/tts 만 부른다.
# 키나 목소리가 없으면 503을 돌려주고, 클라이언트가 브라우저 음성으로 넘어간다.
# ─────────────────────────────────────────────────────────────

# https://elevenlabs.io → 우측 상단 프로필 → API Keys 에서 발급
ELEVENLABS_API_KEY=

# 목소리 ID. Voice Library에서 한국어가 되는 목소리를 고른 뒤 ID를 복사한다.
# 이름이 아니라 ID다. 튜토리얼과 스테이지 3은 같은 인물이라 목소리를 공유한다.
ELEVENLABS_VOICE_LANDLORD=
ELEVENLABS_VOICE_STORE_OWNER_YANG=
ELEVENLABS_VOICE_TA_HAN=

# 모델. 지연과 품질이 맞바뀐다. 비워 두면 eleven_multilingual_v2 를 쓴다.
#   eleven_flash_v2_5        가장 빠름
#   eleven_turbo_v2_5        중간
#   eleven_multilingual_v2   품질 최상, 가장 느림 (기본값)
# 클라이언트가 음성을 통째로 받아 재생하므로 생성 시간이 그대로 대기 시간이 된다.
# 판정에 이미 4초쯤 걸리니, 느리면 여기부터 바꿔 본다.
ELEVENLABS_MODEL_ID=
